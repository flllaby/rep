// 1. ДАННЫЕ
let items = [];
let editingId = null;
const STORAGE_KEY = 'shoppingList';

// 2. DOM
const addForm = document.getElementById('addForm');
const itemName = document.getElementById('itemName');
const itemQuantity = document.getElementById('itemQuantity');
const itemsContainer = document.getElementById('itemsContainer');
const clearAllBtn = document.getElementById('clearAllBtn');

// 3. LOCALSTORAGE
function save() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
}

function load() {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) items = JSON.parse(saved);
}

// 4. УТИЛИТА
function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// 5. РЕНДЕР
function render() {
    if (items.length === 0) {
        itemsContainer.innerHTML = '<p>Список пуст</p>';
        return;
    }

    // Сортируем: невыполненные сверху, выполненные снизу
    const sorted = [...items].sort((a, b) => {
        if (a.completed === b.completed) return 0;
        return a.completed ? 1 : -1;
    });

    itemsContainer.innerHTML = sorted.map(item => {
        const isEditing = editingId === item.id;

        if (isEditing) {
            // Режим редактирования
            return `
                <div>
                    <input type="text" id="editName" value="${escapeHtml(item.name)}">
                    <input type="number" id="editQuantity" value="${item.quantity}" min="1">
                    <button onclick="saveEdit('${item.id}')">💾</button>
                    <button onclick="cancelEdit()">✕</button>
                </div>
            `;
        }

        // Обычный режим
        return `
            <div class="${item.completed ? 'completed' : ''}">
                <input type="checkbox" ${item.completed ? 'checked' : ''}
                       onchange="toggleComplete('${item.id}')">
                <span>${escapeHtml(item.name)}</span>
                <span>×${item.quantity}</span>
                <button onclick="startEdit('${item.id}')">✏️</button>
                <button onclick="deleteItem('${item.id}')">🗑️</button>
            </div>
        `;
    }).join('');
}

// 6. CRUD
function addItem(name, quantity) {
    items.push({
        id: Date.now().toString(),
        name: name.trim(),
        quantity: parseInt(quantity) || 1,
        completed: false,
        createdAt: new Date().toISOString()
    });
    save();
    render();
}

function deleteItem(id) {
    items = items.filter(item => item.id !== id);
    save();
    render();
}

function toggleComplete(id) {
    const item = items.find(item => item.id === id);
    if (!item) return;
    item.completed = !item.completed;
    save();
    render();
}

function clearAll() {
    if (items.length === 0) return;
    if (!confirm('Очистить весь список?')) return;
    items = [];
    save();
    render();
}

// 7. РЕДАКТИРОВАНИЕ
function startEdit(id) {
    editingId = id;
    render();

    // Фокус на поле ввода после рендера
    setTimeout(() => {
        const input = document.getElementById('editName');
        if (input) {
            input.focus();
            input.select();
        }
    }, 50);
}

function saveEdit(id) {
    const nameInput = document.getElementById('editName');
    const quantityInput = document.getElementById('editQuantity');
    if (!nameInput || !quantityInput) return;

    const name = nameInput.value.trim();
    const quantity = parseInt(quantityInput.value);

    if (!name || !quantity || quantity < 1) return;

    const item = items.find(i => i.id === id);
    if (item) {
        item.name = name;
        item.quantity = quantity;
    }

    editingId = null;
    save();
    render();
}

function cancelEdit() {
    editingId = null;
    render();
}

// 8. ФОРМА
function handleSubmit(e) {
    e.preventDefault();

    const name = itemName.value.trim();
    const quantity = itemQuantity.value;

    if (!name) return;
    if (!quantity || parseInt(quantity) < 1) return;

    // Проверка на дубликат среди НЕвыполненных
    const isDuplicate = items.some(item =>
        item.name.toLowerCase() === name.toLowerCase() && !item.completed
    );

    if (isDuplicate) {
        alert('Такой продукт уже есть в списке');
        return;
    }

    addItem(name, quantity);

    itemName.value = '';
    itemQuantity.value = '1';
    itemName.focus();
}

// 9. INIT
function init() {
    load();
    render();

    addForm.addEventListener('submit', handleSubmit);
    clearAllBtn.addEventListener('click', clearAll);
}

document.addEventListener('DOMContentLoaded', init);
