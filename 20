// 1. ДАННЫЕ
let habits = [];
const STORAGE_KEY = 'habits';
const DAYS = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Вс'];

// 2. DOM
const habitName = document.getElementById('habitName');
const habitColor = document.getElementById('habitColor');
const addBtn = document.getElementById('addBtn');
const habitsContainer = document.getElementById('habitsContainer');
const emptyMessage = document.getElementById('emptyMessage');

// 3. LOCALSTORAGE
function save() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(habits));
}

function load() {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) habits = JSON.parse(saved);
}

// 4. УТИЛИТА
function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// 5. РАБОТА С ДАТАМИ

// Индекс сегодняшнего дня: Пн=0, ..., Вс=6
function getTodayIndex() {
    const d = new Date().getDay();   // 0=Вс, 1=Пн, ..., 6=Сб
    return d === 0 ? 6 : d - 1;       // Вс → 6, остальные −1
}

// ID даты в формате 'YYYY-MM-DD'
function getDayId(date) {
    return date.toISOString().split('T')[0];
}

// Дата по индексу дня недели (0=Пн, ..., 6=Вс)
function getDateFromDayIndex(dayIndex) {
    const now = new Date();
    const diff = dayIndex - getTodayIndex();
    const date = new Date(now);
    date.setDate(date.getDate() + diff);
    return date;
}

// 6. СТАТИСТИКА

// Выполнен ли день?
function isDone(habit, dayIndex) {
    const dayId = getDayId(getDateFromDayIndex(dayIndex));
    return habit.doneDays.includes(dayId);
}

// Расчёт серии (streak)
function calculateStreak(habit) {
    if (!habit.doneDays.length) return 0;

    let streak = 0;
    const date = new Date();

    // Если сегодня не отмечено — начинаем со вчера
    if (!habit.doneDays.includes(getDayId(date))) {
        date.setDate(date.getDate() - 1);
    }

    // Идём назад, пока есть отметки
    while (habit.doneDays.includes(getDayId(date))) {
        streak++;
        date.setDate(date.getDate() - 1);
    }

    return streak;
}

// 7. РЕНДЕР
function render() {
    if (habits.length === 0) {
        habitsContainer.innerHTML = '';
        emptyMessage.style.display = 'block';
        return;
    }

    emptyMessage.style.display = 'none';

    habitsContainer.innerHTML = habits.map((habit, index) => {
        const color = habit.color;

        // Кнопки дней
        const daysHtml = DAYS.map((day, dayIndex) => {
            const done = isDone(habit, dayIndex);
            const today = dayIndex === getTodayIndex();
            const date = getDateFromDayIndex(dayIndex).getDate();

            return `
                <button
                    class="${done ? 'done' : ''} ${today ? 'today' : ''}"
                    onclick="toggleDay(${index}, ${dayIndex})"
                    ${done ? `style="background: ${color}"` : ''}
                >
                    ${day}<br>${date}
                </button>
            `;
        }).join('');

        return `
            <div style="border-left: 4px solid ${color}">
                <div>
                    <span style="color: ${color}">${escapeHtml(habit.name)}</span>
                    <button onclick="resetHabit(${index})">Сброс</button>
                    <button onclick="deleteHabit(${index})">Удалить</button>
                </div>
                <div>${daysHtml}</div>
                <div>
                    Выполнено: ${habit.doneDays.length} дней |
                    Серия: ${calculateStreak(habit)} дней
                </div>
            </div>
        `;
    }).join('');
}

// 8. ДОБАВЛЕНИЕ
function addHabit() {
    const name = habitName.value.trim();
    if (!name) return;

    if (habits.some(h => h.name.toLowerCase() === name.toLowerCase())) {
        alert('Такая привычка уже есть');
        return;
    }

    habits.push({
        id: Date.now().toString(),
        name: name,
        color: habitColor.value,
        doneDays: []
    });

    save();
    render();

    habitName.value = '';
    habitName.focus();
}

// 9. ПЕРЕКЛЮЧЕНИЕ ДНЯ
function toggleDay(index, dayIndex) {
    const habit = habits[index];
    if (!habit) return;

    const date = getDateFromDayIndex(dayIndex);

    // Нельзя отмечать будущее
    if (date > new Date()) {
        alert('Нельзя отмечать будущие дни');
        return;
    }

    const dayId = getDayId(date);
    const pos = habit.doneDays.indexOf(dayId);

    if (pos !== -1) {
        habit.doneDays.splice(pos, 1);   // убрать отметку
    } else {
        habit.doneDays.push(dayId);       // добавить отметку
    }

    save();
    render();
}

// 10. УДАЛЕНИЕ И СБРОС
function deleteHabit(index) {
    if (!confirm('Удалить привычку?')) return;
    habits.splice(index, 1);
    save();
    render();
}

function resetHabit(index) {
    if (!confirm('Сбросить прогресс?')) return;
    habits[index].doneDays = [];
    save();
    render();
}

// 11. INIT
function init() {
    load();
    render();
    addBtn.addEventListener('click', addHabit);
}

document.addEventListener('DOMContentLoaded', init);
